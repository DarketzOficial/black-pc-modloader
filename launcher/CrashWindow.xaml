<Window x:Class="BlackLauncher.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="760" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource B.Window}"
        Foreground="{StaticResource B.Fg}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <!-- Same frame as MainWindow.xaml: its own caption, the BLACK banner with the version and the
         social icons, the panel colours and the gold buttons. Only the body and the footer actions
         are different, because this is the crash report. The log is only sent after ENVIAR. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- caption -->
                <RowDefinition Height="Auto" />   <!-- banner -->
                <RowDefinition Height="Auto" />   <!-- report body -->
                <RowDefinition Height="Auto" />   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- the launcher's own title bar, with only the close button (this window is fixed size) -->
            <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptionText" Grid.Column="0" Margin="18,0,10,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource B.FgDim}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CaptionCloseButton}"
                            Content="&#xE8BB;" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <!-- the launcher banner: the same logo, version line, credit and social icons -->
            <Border Grid.Row="1" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,12,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Height="44" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock x:Name="VersionText" Margin="2,4,0,0" FontSize="10.5" HorizontalAlignment="Left"
                                   Foreground="{StaticResource B.FgDim}" />
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource B.FgDim}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CreditLink" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource B.Accent}" Cursor="Hand" MouseLeftButtonUp="Credit_Click" />
                        <Button x:Name="YouTubeButton" Style="{StaticResource SocialButton}" Click="YouTube_Click">
                            <Grid Width="20" Height="15">
                                <Border CornerRadius="3.5" Background="#FFFF0000" />
                                <Path Data="M0,0 L6,3.5 L0,7 Z" Fill="White" Width="6" Height="7" Stretch="Fill"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                        </Button>
                        <Button x:Name="DiscordButton" Style="{StaticResource SocialButton}" Click="Discord_Click">
                            <Path Width="21" Height="21" Stretch="Uniform" Fill="#FF5865F2"
                                  Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- report body -->
            <ScrollViewer Grid.Row="2" MaxHeight="430" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="26,20,26,18">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Fg}" TextWrapping="Wrap" />
                    <TextBlock x:Name="IntroText" FontSize="13.5" Foreground="{StaticResource B.FgDim}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" />
                    <TextBlock x:Name="SubText" FontSize="12.5" Foreground="{StaticResource B.FgDim}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />

                    <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" CornerRadius="7" Padding="15,13" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LogLabel" Grid.Row="0" Grid.Column="0" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"
                                       VerticalAlignment="Top" />
                            <TextBlock x:Name="LogValue" Grid.Row="0" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource B.Fg}" TextWrapping="Wrap" />

                            <TextBlock x:Name="VersionLabel" Grid.Row="1" Grid.Column="0" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"
                                       Margin="0,10,0,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="VersionValue" Grid.Row="1" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource B.Fg}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock x:Name="SystemLabel" Grid.Row="2" Grid.Column="0" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"
                                       Margin="0,10,0,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="SystemValue" Grid.Row="2" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource B.Fg}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock x:Name="SessionLabel" Grid.Row="3" Grid.Column="0" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"
                                       Margin="0,10,0,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="SessionValue" Grid.Row="3" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource B.Fg}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="WhatText" FontSize="12" Foreground="{StaticResource B.FgDim}"
                               TextWrapping="Wrap" LineHeight="17" Margin="0,16,0,0" />

                    <TextBlock x:Name="StatusText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Accent}" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,14,0,0" />
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFF9A8E"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- footer, same panel and buttons as the launcher -->
            <Border Grid.Row="3" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenFolderButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                            Click="OpenFolder_Click" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NoButton" Style="{StaticResource GhostButton}" Click="No_Click" />
                        <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Click="Send_Click"
                                Margin="10,0,0,0" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
