<Window x:Class="BlackLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource B.Window}"
        Foreground="{StaticResource B.Fg}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <!-- The update prompt, in the launcher's own theme (same panel colours, gold buttons, no system chrome).
         It stays on screen while the download runs and is closed by the launcher itself when it restarts. -->
    <Border Background="{StaticResource B.Window}" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- caption -->
            <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1" Padding="22,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                        <TextBlock Text="ATUALIZAÇÃO DO MODLOADER" x:Name="OverlineText" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource B.Fg}" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CaptionCloseButton}"
                            Content="&#xE8BB;" Click="Close_Click" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- body: version, what's new, download progress -->
            <ScrollViewer Grid.Row="1" MaxHeight="330" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="24,20,24,14">
                <StackPanel>
                    <TextBlock x:Name="IntroText" FontSize="13" Foreground="{StaticResource B.FgDim}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NotesLabel" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Accent}" Margin="0,20,0,0" />
                    <TextBlock x:Name="NotesText" FontSize="13" Foreground="{StaticResource B.Fg}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,20,0,0">
                        <ProgressBar x:Name="Progress" Style="{StaticResource DarkProgress}" />
                        <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource B.FgDim}"
                                   Margin="0,9,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" FontSize="12.5"
                               Foreground="#FFFF9A8E" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- actions -->
            <Border Grid.Row="2" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterButton" Style="{StaticResource GhostButton}" Click="Later_Click" />
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Click="Update_Click"
                            Margin="10,0,0,0" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
