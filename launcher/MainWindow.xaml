<Window x:Class="BlackLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BLACK" Height="720" Width="1100" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource B.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Foreground="{StaticResource B.Fg}"
        FontFamily="Segoe UI">

    <!-- No system title bar: the launcher draws its own (the caption row below) in the theme, with its
         own minimise/maximise/close. Everything Windows did for the old bar still works - dragging,
         double-click to maximise, the edges to resize, Aero snap, right-click for the window menu, the
         taskbar label (Title) - because WindowChrome keeps the window a normal, resizable one.
         CaptionHeight is the draggable strip; the buttons inside it are marked hit-test-visible in the
         chrome so a click reaches them instead of starting a drag. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- our title bar -->
                <RowDefinition Height="Auto" />   <!-- banner -->
                <RowDefinition Height="Auto" />   <!-- selected game -->
                <RowDefinition Height="*" />      <!-- tabs -->
                <RowDefinition Height="Auto" />   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ========================= caption (the launcher's own title bar) ========================= -->
            <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptionText" Grid.Column="0" Margin="18,0,10,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource B.FgDim}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                                Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= banner ============================= -->
            <Border Grid.Row="1" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,12,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Image x:Name="Logo" Source="Assets/logo.png" Height="44" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock x:Name="VersionText" Margin="2,4,0,0" FontSize="10.5" HorizontalAlignment="Left"
                                   Foreground="{StaticResource B.FgDim}" />
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource B.FgDim}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="GameBadge" CornerRadius="4" Padding="10,5" VerticalAlignment="Center"
                                Background="#33C0392B" BorderBrush="#FFC0392B" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="GameBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#FFFF9A8E" />
                        </Border>
                        <TextBlock x:Name="CreditLink" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource B.Accent}" Cursor="Hand" MouseLeftButtonUp="Credit_Click" />
                        <!-- the credit link opens the YouTube channel, so the channel's own mark sits beside it -->
                        <Button x:Name="YouTubeButton" Style="{StaticResource SocialButton}" Click="YouTube_Click">
                            <Grid Width="20" Height="15">
                                <Border CornerRadius="3.5" Background="#FFFF0000" />
                                <Path Data="M0,0 L6,3.5 L0,7 Z" Fill="White" Width="6" Height="7" Stretch="Fill"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                        </Button>
                        <Button x:Name="DiscordButton" Style="{StaticResource SocialButton}" Click="Discord_Click">
                            <Path Width="21" Height="21" Stretch="Uniform" Fill="#FF5865F2"
                                  Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                        </Button>
                        <Button x:Name="DonateButton" Style="{StaticResource GhostButton}" Click="Donate_Click"
                                Margin="8,0,0,0" Padding="9,4" Height="30" VerticalAlignment="Center"
                                FontSize="11" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#FFFF7A8A" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DonateButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The same launcher can start either game; the selection never changes either install. -->
            <Border Grid.Row="2" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TargetLabel" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource B.FgDim}" FontSize="12" />
                    <ComboBox x:Name="TargetCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                              SelectionChanged="Target_Changed" />
                    <Button x:Name="TargetBrowseButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                            Content="Localizar recompilação" Click="BrowseRecomp_Click" Margin="10,0,0,0" Padding="10,6" />
                    <TextBlock x:Name="TargetVersion" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource B.FgDim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- ============================= tabs ============================= -->
            <TabControl x:Name="Tabs" Grid.Row="3" Style="{StaticResource DarkTabControl}" />

            <!-- ============================= footer ============================= -->
            <Border Grid.Row="4" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LangLabel" FontSize="11" Foreground="{StaticResource B.FgDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="LangCombo" Style="{StaticResource DarkComboBox}" Width="130"
                                  SelectionChanged="LangCombo_Changed" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                               Foreground="{StaticResource B.FgDim}" FontSize="12" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}" Click="Update_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdateButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MuteButton" Style="{StaticResource GhostButton}" Click="Mute_Click" Margin="0,0,10,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="12,7" />
                        <Button x:Name="RestoreButton" Style="{StaticResource GhostButton}" Click="Restore_Click" Margin="0,0,10,0" />
                        <Button x:Name="SaveButton" Style="{StaticResource GhostButton}" Click="Save_Click" Margin="0,0,10,0" />
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="Play_Click"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- the save notice: shown for a moment in the middle of the top, above the tab's own content -->
            <Border x:Name="Toast" Grid.Row="3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="20,10"
                    CornerRadius="8" Background="#F21B1C20" BorderBrush="{StaticResource B.Accent}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"
                               Foreground="{StaticResource B.AccentHi}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Fg}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
